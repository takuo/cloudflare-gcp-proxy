# ローカル開発 (wrangler dev) 用。.dev.vars にコピーして値を設定する。
# サービスアカウントキー JSON を 1 行で（改行は \n のまま）
GOOGLE_SERVICE_ACCOUNT_KEY={"type":"service_account","client_email":"proxy@PROJECT.iam.gserviceaccount.com","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","token_uri":"https://oauth2.googleapis.com/token"}
