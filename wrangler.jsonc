{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cloudrun-proxy",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "observability": { "enabled": true },
  "vars": {
    // 転送先 Cloud Run サービスの URL（パスは無視され、オリジンのみ使用）
    "CLOUD_RUN_URL": "https://your-service-xxxxxxxxxx-an.a.run.app",
    // ID トークンの audience。省略時は CLOUD_RUN_URL のオリジン
    // "AUDIENCE": "https://your-service-xxxxxxxxxx-an.a.run.app",
    // 403 を返す URL パターン（URLPattern 構文）。先頭に "METHOD " を付けるとメソッド限定
    "BLOCKED_URL_PATTERNS": [
      "/admin{/*}?",
      "/internal/*",
      "DELETE /api/*"
    ]
    // "true" にするとクライアントの Authorization を残し、ID トークンは X-Serverless-Authorization で送る
    // "PRESERVE_CLIENT_AUTHORIZATION": "false"
  }
  // GOOGLE_SERVICE_ACCOUNT_KEY は secret で設定:
  //   npx wrangler secret put GOOGLE_SERVICE_ACCOUNT_KEY < service-account.json
}
