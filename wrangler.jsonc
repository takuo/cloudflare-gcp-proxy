{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cloudrun-proxy",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "observability": { "enabled": true },
  // 変数は Cloudflare ダッシュボード（Settings → Variables and Secrets）で管理する。
  // keep_vars: true により、デプロイ時にダッシュボードの変数を消さない。
  //   CLOUD_RUN_URL                  (Text, 必須)
  //   GOOGLE_SERVICE_ACCOUNT_KEY     (Secret, 必須)
  //   AUDIENCE                       (Text, 任意)
  //   BLOCKED_URL_PATTERNS           (JSON または Text, 任意)
  //   PRESERVE_CLIENT_AUTHORIZATION  (Text, 任意)
  // ローカル開発 (wrangler dev) では .dev.vars に書く（.dev.vars.example 参照）。
  "keep_vars": true
}
